<Window x:Class="DesktopViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopViewer"
        Width="48" Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="50" Top="200">

    <Window.Resources>
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation
                Storyboard.TargetName="CaptureBtn"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="1.0" To="0.85" Duration="0:0:0.1"
                AutoReverse="True" />
            <DoubleAnimation
                Storyboard.TargetName="CaptureBtn"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="1.0" To="0.85" Duration="0:0:0.1"
                AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation
                Storyboard.TargetName="ButtonIcon"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:1"
                RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Drop shadow effect -->
        <Ellipse Width="46" Height="46" Fill="#20000000" Margin="1,2,0,0" />

        <!-- Main button -->
        <Button x:Name="CaptureBtn"
                Width="44" Height="44"
                Click="CaptureButton_Click"
                MouseRightButtonUp="CaptureButton_RightClick"
                MouseLeftButtonDown="Button_MouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">

            <Button.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Button.RenderTransform>

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="BtnBg" Fill="{StaticResource PrimaryBrush}" />
                        <Ellipse x:Name="BtnBgHover" Fill="{StaticResource PrimaryHoverBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBgHover" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <TextBlock x:Name="ButtonIcon"
                       Text="📷"
                       FontSize="18"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="0" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Button>

        <!-- Context menu -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="📷  Capture Screen" Click="CaptureFullScreen_Click" FontWeight="Bold" />
                <MenuItem Header="🔲  Capture Region" Click="CaptureRegion_Click" />
                <Separator />
                <MenuItem Header="⚙️  Settings" Click="Settings_Click" />
                <Separator />
                <MenuItem Header="❌  Exit" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
