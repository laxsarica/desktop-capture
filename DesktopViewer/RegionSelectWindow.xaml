<Window x:Class="DesktopViewer.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Region"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Cursor="Cross">

    <Canvas x:Name="SelectionCanvas"
            MouseLeftButtonDown="Canvas_MouseDown"
            MouseMove="Canvas_MouseMove"
            MouseLeftButtonUp="Canvas_MouseUp"
            Focusable="True">

        <!-- Semi-transparent dark overlay -->
        <Canvas.Background>
            <SolidColorBrush Color="#000000" Opacity="0.3" />
        </Canvas.Background>

        <!-- Instruction text -->
        <TextBlock x:Name="InstructionText"
                   Text="Click and drag to select a region  •  ESC to cancel"
                   Foreground="White"
                   FontSize="16"
                   FontFamily="Segoe UI"
                   Canvas.Left="20"
                   Canvas.Top="20">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" Color="Black" BlurRadius="3" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Selection rectangle (drawn dynamically) -->
        <Border x:Name="SelectionRect"
                BorderBrush="#6C63FF"
                BorderThickness="2"
                Background="#206C63FF"
                Visibility="Collapsed"
                CornerRadius="2">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Color="#6C63FF" BlurRadius="8" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <!-- Size label -->
        <TextBlock x:Name="SizeLabel"
                   Foreground="White"
                   FontSize="12"
                   FontFamily="Segoe UI Semibold"
                   Visibility="Collapsed"
                   Padding="4,2">
            <TextBlock.Background>
                <SolidColorBrush Color="#6C63FF" Opacity="0.85" />
            </TextBlock.Background>
        </TextBlock>
    </Canvas>
</Window>
