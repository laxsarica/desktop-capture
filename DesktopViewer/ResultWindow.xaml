<Window x:Class="DesktopViewer.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Result"
        Width="420" Height="340"
        MinWidth="320" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">

    <Border CornerRadius="12"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Margin="8">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.4" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🤖"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <TextBlock Grid.Column="1"
                               Text="AI Analysis Result"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontFamily="Segoe UI Semibold"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Content="✕"
                            Click="Close_Click"
                            Width="28" Height="28"
                            FontSize="12"
                            Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        CornerRadius="6"
                                        Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background"
                                                Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content area -->
            <ScrollViewer Grid.Row="1"
                          Margin="16,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Detected question (if any) -->
                    <Border x:Name="QuestionPanel"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}"
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="DETECTED QUESTION"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="10"
                                       FontFamily="Segoe UI Semibold"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="QuestionText"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Answer -->
                    <TextBlock Text="ANSWER"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="10"
                               FontFamily="Segoe UI Semibold"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="AnswerText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               LineHeight="20" />

                    <!-- Confidence -->
                    <StackPanel x:Name="ConfidencePanel"
                                Orientation="Horizontal"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Confidence: "
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="ConfidenceText"
                                   FontSize="11"
                                   FontFamily="Segoe UI Semibold" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer with OCR toggle -->
            <Border Grid.Row="2"
                    CornerRadius="0,0,12,12"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleOcrBtn"
                            Grid.Column="0"
                            Content="📝 Show OCR Text"
                            Click="ToggleOcr_Click"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        Padding="8,4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background"
                                                Value="#22FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="1"
                            Content="📋 Copy"
                            Click="Copy_Click"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        Padding="8,4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background"
                                                Value="#22FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- OCR text panel (hidden by default) -->
            <Border x:Name="OcrPanel"
                    Grid.Row="1"
                    CornerRadius="8"
                    Background="#FF151525"
                    Margin="8"
                    Padding="12"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OcrText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
